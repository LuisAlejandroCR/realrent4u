{
  "expo": {
    "name": "RealRent4U",
    "slug": "realrent4u",
    "scheme": "realrent4u",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F5F0",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    }
  }
}
